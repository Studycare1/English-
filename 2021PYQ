<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bihar Board 12th English PYQ (Glassmorphism UI)</title>
    <style>
        /* --- NEOMORPHIC & GLASSMORPHISM STYLES --- */
        * { 
            box-sizing: border-box; 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            margin: 0;
            padding: 0;
        }

        body { 
            background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
            min-height: 100vh;
            display: flex; 
            justify-content: center; 
            padding: 20px;
            color: #333;
        }

        .container { 
            background: rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            max-width: 900px; 
            width: 100%; 
            padding: 40px; 
            border-radius: 20px; 
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);
            position: relative;
        }
        
        h1, h2, h3 { text-align: center; color: #1a1a2e; margin-bottom: 20px;}
        
        .section { display: none; }
        .active-section { display: block; animation: fadeIn 0.5s ease; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Inputs & Buttons */
        input[type="text"], input[type="password"] { 
            width: 100%; 
            padding: 15px; 
            margin: 15px 0; 
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 12px; 
            font-size: 16px; 
            outline: none;
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.05);
            transition: 0.3s;
        }
        input[type="text"]:focus, input[type="password"]:focus {
            background: rgba(255, 255, 255, 0.8);
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.1), 0 0 10px rgba(255,255,255,0.5);
        }

        button { 
            width: 100%; 
            padding: 15px; 
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; 
            border: none; 
            border-radius: 12px; 
            font-size: 18px; 
            cursor: pointer; 
            transition: 0.3s; 
            font-weight: bold; 
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            margin-top: 15px;
        }
        button:hover { 
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }
        button:active {
            transform: translateY(0);
        }

        /* Quiz Options */
        .question-box { 
            margin-bottom: 25px; 
            padding: 20px; 
            border-radius: 15px; 
            background: rgba(255, 255, 255, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.6);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .question-text { font-weight: 700; margin-bottom: 15px; font-size: 17px; color: #1a1a2e; }
        
        .option { 
            display: block; 
            margin: 10px 0; 
            padding: 15px; 
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 10px; 
            cursor: pointer; 
            transition: all 0.3s ease;
            font-size: 15px;
            position: relative;
            overflow: hidden;
        }
        
        .option:hover:not(.locked) { 
            background: rgba(255, 255, 255, 0.9);
            transform: scale(1.01);
        }

        /* Instant Feedback Colors */
        .option.correct-ans {
            background: rgba(40, 167, 69, 0.8) !important;
            color: white;
            border-color: #28a745;
            font-weight: bold;
            box-shadow: 0 0 15px rgba(40, 167, 69, 0.4);
        }
        .option.wrong-ans {
            background: rgba(220, 53, 69, 0.8) !important;
            color: white;
            border-color: #dc3545;
            font-weight: bold;
            box-shadow: 0 0 15px rgba(220, 53, 69, 0.4);
        }
        .option.locked {
            cursor: not-allowed;
        }

        /* Instant Reason Box */
        .instant-reason {
            display: none;
            margin-top: 15px;
            padding: 15px;
            background: rgba(255, 255, 255, 0.8);
            border-left: 5px solid #ffc107;
            border-radius: 5px;
            font-size: 14px;
            color: #333;
            animation: fadeIn 0.3s ease;
        }

        /* Results */
        .result-box { margin-bottom: 20px; padding: 20px; border-radius: 10px; background: rgba(255, 255, 255, 0.5); border: 1px solid rgba(255,255,255,0.8); }
        .result-box.correct { border-left: 6px solid #28a745; }
        .result-box.incorrect { border-left: 6px solid #dc3545; }
        
        /* Long Answers Box */
        .long-ans-box { margin-top: 30px; padding: 25px; background: rgba(255, 243, 205, 0.6); border-radius: 15px; border: 1px solid rgba(255, 230, 156, 0.8); backdrop-filter: blur(5px); }
        .long-ans-box h3 { text-align: left; border-bottom: 2px solid #ffc107; padding-bottom: 10px; margin-bottom: 15px; color: #856404; }
        .ans-item { margin-bottom: 15px; font-size: 15px; line-height: 1.6; color: #333; }
        .ans-item strong { color: #0056b3; }

        /* Rank List */
        .rank-table { width: 100%; border-collapse: collapse; margin-top: 20px; background: rgba(255,255,255,0.4); border-radius: 10px; overflow: hidden; }
        .rank-table th, .rank-table td { padding: 15px; border-bottom: 1px solid rgba(0,0,0,0.1); text-align: left; }
        .rank-table th { background-color: rgba(102, 126, 234, 0.8); color: white; }
        
        .nav-links { text-align: center; margin-top: 25px; }
        .nav-links span { color: #764ba2; cursor: pointer; font-weight: bold; text-decoration: underline; }

        /* Scroll to top */
        #scrollTopBtn {
            display: none; position: fixed; bottom: 30px; right: 30px; z-index: 99;
            font-size: 20px; border: none; outline: none; background: #764ba2; color: white;
            cursor: pointer; padding: 15px; border-radius: 50%; width: 50px; height: 50px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            display: flex; justify-content: center; align-items: center;
        }
    </style>
</head>
