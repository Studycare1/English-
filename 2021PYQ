    let currentStudentName = "";
    let userAnswers = {}; // Stores user's answers

    // --- SCROLL TO TOP LOGIC ---
    let mybutton = document.getElementById("scrollTopBtn");
    window.onscroll = function() { scrollFunction() };
    function scrollFunction() {
        if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
            mybutton.style.display = "flex";
        } else {
            mybutton.style.display = "none";
        }
    }
    function topFunction() {
        document.body.scrollTop = 0;
        document.documentElement.scrollTop = 0;
    }

    // --- NAVIGATION FUNCTIONS ---
    function showSection(sectionId) {
        document.querySelectorAll('.section').forEach(sec => sec.classList.remove('active-section'));
        document.getElementById(sectionId).classList.add('active-section');
        topFunction();
    }

    // --- 1. LOGIN / START TEST ---
    function startTest() {
        const nameInput = document.getElementById('studentName').value.trim();
        if (nameInput === "") {
            alert("Please enter your name!");
            return;
        }
        currentStudentName = nameInput;
        renderQuestions();
        showSection('quiz-section');
    }

    // --- 2. RENDER QUESTIONS (WITH INSTANT FEEDBACK LOGIC) ---
    function renderQuestions() {
        const container = document.getElementById('questions-container');
        container.innerHTML = "";
        
        questions.forEach((q, index) => {
            let html = `<div class="question-box" id="qbox-${q.id}">`;
            html += `<div class="question-text">Q${q.id}. ${q.question}</div>`;
            
            // Options
            q.options.forEach((opt, optIndex) => {
                html += `
                    <div class="option" id="opt-${q.id}-${optIndex}" onclick="checkAnswerInstant(${q.id}, ${optIndex})">
                        <strong>${String.fromCharCode(65 + optIndex)}.</strong> ${opt}
                    </div>
                `;
            });
            
            // Reason Box (Hidden initially)
            html += `<div class="instant-reason" id="reason-${q.id}">
                        <strong>Reason:</strong> ${q.reason}
                     </div>`;
            
            html += `</div>`;
            container.innerHTML += html;
        });
    }

    // --- 3. INSTANT FEEDBACK ON CLICK ---
    function checkAnswerInstant(qId, selectedIndex) {
        // If already answered, do nothing (lock)
        if (userAnswers[qId] !== undefined) return;

        const qData = questions.find(q => q.id === qId);
        const correctIndex = qData.correct;
        
        // Record answer
        userAnswers[qId] = selectedIndex;

        // Visual updates
        const selectedOptElement = document.getElementById(`opt-${qId}-${selectedIndex}`);
        const correctOptElement = document.getElementById(`opt-${qId}-${correctIndex}`);
        const reasonElement = document.getElementById(`reason-${qId}`);

        // Lock all options for this question
        qData.options.forEach((_, i) => {
            document.getElementById(`opt-${qId}-${i}`).classList.add('locked');
        });

        if (selectedIndex === correctIndex) {
            selectedOptElement.classList.add('correct-ans');
        } else {
            selectedOptElement.classList.add('wrong-ans');
            correctOptElement.classList.add('correct-ans');
        }

        // Show Reason
        reasonElement.style.display = "block";
    }

    // --- 4. SUBMIT TEST ---
    function submitTest() {
        const answeredCount = Object.keys(userAnswers).length;
        const totalQuestions = questions.length;
        
        // Allow submission anytime, but warn if incomplete
        if (answeredCount < totalQuestions) {
            const confirmSubmit = confirm(`You have answered ${answeredCount} out of ${totalQuestions} questions.\n\nDo you want to submit anyway? Unanswered questions will be marked wrong.`);
            if (!confirmSubmit) return;
        }

        // Calculate Score
        let score = 0;
        questions.forEach(q => {
            if (userAnswers[q.id] === q.correct) {
                score++;
            }
        });

        saveToDatabase(currentStudentName, score, totalQuestions);
        showResults(score, totalQuestions);
    }

    // --- 5. SHOW RESULTS ---
    function showResults(score, totalQuestions) {
        document.getElementById('score-display').innerText = `${currentStudentName}, your score is: ${score} / ${totalQuestions}`;
        
        const reviewContainer = document.getElementById('review-container');
        reviewContainer.innerHTML = "";

        questions.forEach((q, index) => {
            const userAns = userAnswers[q.id];
            const isCorrect = userAns === q.correct;
            
            // For unanswered questions
            let userAnswerText = userAns !== undefined ? q.options[userAns] : "Not Answered";

            let html = `<div class="result-box ${isCorrect ? 'correct' : 'incorrect'}">`;
            html += `<strong>Q${q.id}. ${q.question}</strong><br><br>`;
            
            html += `<span style="color: ${isCorrect ? '#28a745' : '#dc3545'};"><strong>Your Answer:</strong> ${userAnswerText}</span><br>`;
            
            if (!isCorrect) {
                html += `<span style="color: #28a745;"><strong>Correct Answer:</strong> ${q.options[q.correct]}</span><br>`;
            }
            
            html += `<div style="margin-top: 10px; padding: 10px; background: rgba(255,255,255,0.6); border-radius: 8px;"><strong>Reason:</strong> ${q.reason}</div>`;
            html += `</div>`;
            
            reviewContainer.innerHTML += html;
        });

        showSection('result-section');
    }

    // --- 6. DATABASE (LOCAL STORAGE) & RANK LIST ---
    function saveToDatabase(name, score, total) {
        let students = JSON.parse(localStorage.getItem('pyq_students')) || [];
        const date = new Date().toLocaleDateString();
        
        students.push({ name, score, total, date });
        
        // Sort by score descending
        students.sort((a, b) => b.score - a.score);
        
        localStorage.setItem('pyq_students', JSON.stringify(students));
    }

    function showRankListPrompt() {
        showSection('rank-section');
        document.getElementById('password-prompt').style.display = 'block';
        document.getElementById('rank-list-data').style.display = 'none';
        document.getElementById('adminPassword').value = '';
    }

    function checkPassword() {
        const password = document.getElementById('adminPassword').value;
        
        // PASSWORD LOGIC
        if (password === "Alisha123") {
            document.getElementById('password-prompt').style.display = 'none';
            document.getElementById('rank-list-data').style.display = 'block';
            renderRankList();
        } else {
            alert("Incorrect Password!");
        }
    }

    function renderRankList() {
        const tbody = document.getElementById('rank-tbody');
        tbody.innerHTML = "";
        
        let students = JSON.parse(localStorage.getItem('pyq_students')) || [];
        
        if (students.length === 0) {
            tbody.innerHTML = "<tr><td colspan='4' style='text-align:center;'>No students have taken the test yet.</td></tr>";
            return;
        }

        students.forEach((student, index) => {
            let tr = document.createElement('tr');
            tr.innerHTML = `
                <td>${index + 1}</td>
                <td>${student.name}</td>
                <td>${student.score} / ${student.total}</td>
                <td>${student.date}</td>
            `;
            tbody.appendChild(tr);
        });
    }
</script>

