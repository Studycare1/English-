        { id: 19, question: "Choose the correct sentence:", options: ["His bride is beautiful", "Beautiful bride is his", "Bride had beautiful", "He bride is beautiful"], correct: 0, reason: "Subject + Verb + Complement structure is correct in option (a)." },
