    const questions = [
        { id: 1, question: "Choose the correct sentence:", options: ["Junior employees need advice from their bosses now and then.", "Junior employees need an advice from their bosses now and then.", "Junior employees need an advise from their bosses now and then.", "Junior employees needs an advice from their bosses now and then."], correct: 0, reason: "'Advice' is an uncountable noun. Also, the subject is plural, so 'need' is correct." },
        { id: 2, question: "He said something. I did not hear it. (Choose the correct combination):", options: ["I said something which he did not hear", "He did not hear what I said", "I did not hear what he said", "I did hear what he said"], correct: 2, reason: "The combined sentence uses a noun clause 'what he said' as the object of 'did not hear'." },
        { id: 3, question: "One man's trash is another man's ........... (Choose the most suitable word):", options: ["pleasure", "treasure", "crash", "damage"], correct: 1, reason: "The correct proverb is 'One man's trash is another man's treasure'." },
        { id: 4, question: "Smallpox has been eradicated ........... India. (Choose the correct preposition):", options: ["for", "from", "within", "out"], correct: 1, reason: "'Eradicated' is followed by the preposition 'from'." },
